{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mentoria-home",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "850620261",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "previews": {
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    },
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "CHAT_LIMITER",
        "namespace_id": "850620262",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  }
}
