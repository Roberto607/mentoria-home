{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "Mentoria-home",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "850620261",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
